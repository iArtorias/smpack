<UserControl x:Class="SmpackGui.Views.TexturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SmpackGui.Controls"
             xmlns:vm="clr-namespace:SmpackGui.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:TexturesViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="380"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="6*" MinWidth="360"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <!-- List. -->
        <DockPanel Margin="20,18,4,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Command="{Binding BuildIndexCommand}" ToolTip="Scan every WAD for texture names (1-3 minutes)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource BtnIcon}"/>
                        <TextBlock Text="Rebuild index"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Textures" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding IndexInfo}" Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Filters. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8" IsEnabled="{Binding IsIndexLoaded}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search name, hash, WAD or pack...  (Ctrl+F)"
                             Padding="30,5,8,5"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource TextFaint}" Margin="10,0,0,0" IsHitTestVisible="False"
                               FontSize="13"/>
                </Grid>
                <ComboBox Grid.Column="1" Width="190" Margin="8,0,0,0" ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}"
                          ToolTip="Where the full resolution texture lives"/>
                <ComboBox Grid.Column="2" Width="120" Margin="8,0,0,0" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"/>
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="2,0,2,8" IsEnabled="{Binding IsIndexLoaded}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}" Foreground="{StaticResource TextFaint}" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Only replaced" IsChecked="{Binding OnlyModded}" FontSize="12" Margin="0,0,16,0"/>
                    <CheckBox Content="Include unnamed textures of this pack" IsChecked="{Binding IncludeUnnamed}" FontSize="12"
                              Visibility="{Binding IsPackSelected, Converter={StaticResource BoolVis}}"
                              ToolTip="Textures no WAD refers to by name are listed by their hex id"/>
                    <Button Style="{StaticResource GhostButton}" Content="Clear filters" Command="{Binding ClearFiltersCommand}" FontSize="12" MinHeight="22"
                            Padding="6,0" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Batch actions. -->
            <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ExportPngCommand}" Margin="0,0,6,0" ToolTip="Export the selected textures as PNG (Ctrl-click or Shift-click to select several)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" Style="{StaticResource BtnIcon}"/>
                            <TextBlock Text="Export PNG"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportDdsCommand}" Margin="0,0,6,0" ToolTip="Export the selected textures as DDS with their smpack sidecar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource BtnIcon}"/>
                            <TextBlock Text="Export DDS"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ReplaceFolderCommand}"
                            ToolTip="Import a folder of edited images named after textures (e.g. from Export PNG). All of them are converted and added to your mod">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;" Style="{StaticResource BtnIcon}"/>
                            <TextBlock Text="Import folder..."/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding SelectedCount, StringFormat={}{0} selected}" Foreground="{StaticResource TextFaint}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>

            <Grid>
                <Border Background="{StaticResource Bg1}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DataGrid x:Name="Grid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" SelectionMode="Extended"
                              AutoGenerateColumns="False" Margin="2,2,2,4" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Replace..." Command="{Binding ReplaceCommand}" Icon="&#xE8AB;"/>
                                <MenuItem Header="Revert to original" Command="{Binding RevertCommand}" Icon="&#xE7A7;"/>
                                <Separator/>
                                <MenuItem Header="Export selected as PNG..." Command="{Binding ExportPngCommand}" Icon="&#xEDE1;"/>
                                <MenuItem Header="Export selected as DDS..." Command="{Binding ExportDdsCommand}" Icon="&#xE74E;"/>
                                <MenuItem Header="Show original DDS in Explorer" Command="{Binding OpenCacheCommand}" Icon="&#xE838;"/>
                                <Separator/>
                                <MenuItem Header="Copy name" Command="{Binding CopyNameCommand}" Icon="&#xE8C8;"/>
                                <MenuItem Header="Copy content hash" Command="{Binding CopyHashCommand}" Icon="&#xE8C8;"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="26" CanUserResize="False" SortMemberPath="IsModded">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Ember}" ToolTip="Replaced in your mod"
                                                 Visibility="{Binding IsModded, Converter={StaticResource BoolVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" MinWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeLabel}" SortMemberPath="Pixels" Width="86">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="FORMAT" Binding="{Binding FormatLabel}" Width="78">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="WADS" Binding="{Binding WadCount}" Width="52">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Empty state, no index yet. -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Padding="28"
                        Visibility="{Binding IsIndexLoaded, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <StackPanel>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{StaticResource Accent}" Margin="0,0,0,12"/>
                        <TextBlock Text="Index the game's textures" Style="{StaticResource H2}" FontSize="17"/>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,16"
                                   Text="Texture names only exist inside the WAD files, so smpack scans all of them once and remembers which pack holds each texture. This takes a minute or two on HDD. You only need to do it again after a game update."/>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding BuildIndexCommand}" HorizontalAlignment="Left" Padding="18,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource BtnIcon}"/>
                                <TextBlock Text="Build texture index"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,70,0,12"/>

        <!-- Preview. -->
        <DockPanel Grid.Column="2" Margin="4,18,12,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" MinHeight="46">
                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center"
                        Visibility="{Binding Selected.IsModded, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Original" GroupName="cmp"
                                     IsChecked="{Binding ShowModded, Converter={StaticResource Not}, Mode=OneWay}"
                                     Command="{Binding ShowModdedCommand}" CommandParameter="orig"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="cmp" IsChecked="{Binding ShowModded, Mode=OneWay}"
                                     Command="{Binding ShowModdedCommand}" CommandParameter="mod">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Ember}" Margin="0,0,6,0"/>
                                <TextBlock Text="Replacement"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Selected.Name, FallbackValue=Preview}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding PreviewSource}" Foreground="{StaticResource TextFaint}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Viewer toolbar. -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" DataContext="{Binding Preview}" IsEnabled="{Binding HasImage}">
                <Border Style="{StaticResource SegmentHost}" Margin="0,0,8,4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="RGBA" GroupName="ch" ToolTip="Colour with alpha over a checkerboard"
                                     IsChecked="{Binding Channel, Converter={StaticResource EnumEq}, ConverterParameter=RGBA}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="RGB" GroupName="ch"
                                     IsChecked="{Binding Channel, Converter={StaticResource EnumEq}, ConverterParameter=RGB}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="R" GroupName="ch" Foreground="#FF8C8C"
                                     IsChecked="{Binding Channel, Converter={StaticResource EnumEq}, ConverterParameter=R}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="G" GroupName="ch" Foreground="#8CE0A0"
                                     IsChecked="{Binding Channel, Converter={StaticResource EnumEq}, ConverterParameter=G}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="B" GroupName="ch" Foreground="#8CB8FF"
                                     IsChecked="{Binding Channel, Converter={StaticResource EnumEq}, ConverterParameter=B}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="A" GroupName="ch"
                                     IsChecked="{Binding Channel, Converter={StaticResource EnumEq}, ConverterParameter=A}"/>
                    </StackPanel>
                </Border>
                <ComboBox Width="170" Margin="0,0,8,4" ItemsSource="{Binding MipLabels}" SelectedIndex="{Binding Mip}" ToolTip="Mip level"/>
                <ComboBox Width="120" Margin="0,0,8,4" ItemsSource="{Binding SliceLabels}" SelectedIndex="{Binding Slice}"
                          Visibility="{Binding IsMultiSlice, Converter={StaticResource BoolVis}}" ToolTip="Cube face or array slice"/>
                <CheckBox Content="Rebuild normal Z" IsChecked="{Binding ReconstructZ}" Margin="4,0,12,4" FontSize="12" VerticalAlignment="Center"
                          Visibility="{Binding IsTwoChannel, Converter={StaticResource BoolVis}}"
                          ToolTip="BC5 normal maps store only X and Y. Compute Z for a familiar blue normal map look"/>
                <StackPanel Orientation="Horizontal" Margin="4,0,8,4" Visibility="{Binding IsHdr, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Exposure" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider Width="110" Minimum="0.05" Maximum="8" Value="{Binding Exposure}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Exposure, StringFormat={}{0:0.00}x}" Foreground="{StaticResource TextDim}" FontSize="12" Width="40"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </WrapPanel>

            <TextBlock x:Name="HoverText" DockPanel.Dock="Bottom" Style="{StaticResource Mono}" Foreground="{StaticResource TextDim}" Margin="2,8,0,0"
                       Text=" " FontSize="11.5"/>

            <Border CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <c:TextureViewer x:Name="Viewer" Source="{Binding Preview.Bitmap}"
                                     ShowChecker="{Binding Preview.Channel, Converter={StaticResource EnumEq}, ConverterParameter=RGBA}"/>
                    <Path Style="{StaticResource Spinner}" Width="28" Height="28" IsHitTestVisible="False"
                          Visibility="{Binding Preview.IsLoading, Converter={StaticResource BoolVis}}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{StaticResource BorderStrong}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a texture to preview it" Foreground="{StaticResource TextFaint}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <Border Background="{StaticResource DangerSoft}" CornerRadius="8" Padding="14,10" Margin="24" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Visibility="{Binding Preview.Error, Converter={StaticResource NotNullVis}}">
                        <TextBlock Text="{Binding Preview.Error}" TextWrapping="Wrap" Foreground="#FFB3B1" MaxWidth="420"/>
                    </Border>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Actions and details. -->
        <Border Grid.Column="3" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,20,18,18">
                    <TextBlock Text="REPLACE" Style="{StaticResource Label}"/>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding ReplaceCommand}" Padding="14,10" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" Style="{StaticResource BtnIcon}" FontSize="15"/>
                            <StackPanel>
                                <TextBlock Text="Replace with image..." FontSize="13.5"/>
                                <TextBlock Text="PNG, TGA, JPG, EXR or DDS" FontWeight="Normal" FontSize="11" Opacity="0.75"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Dim}" FontSize="11.5" Margin="2,8,0,0"
                               Text="Tip: drag an image onto the preview. It's converted to the original format with a full mip chain and added to your mod."/>
                    <Button Command="{Binding RevertCommand}" Margin="0,12,0,0" HorizontalContentAlignment="Left"
                            Visibility="{Binding Selected.IsModded, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource BtnIcon}"/>
                            <TextBlock Text="Revert to original"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="EXPORT" Style="{StaticResource Label}" Margin="0,22,0,4"/>
                    <UniformGrid Columns="2">
                        <Button Command="{Binding ExportPngCommand}" Margin="0,0,4,0" Content="PNG..." ToolTip="Full resolution PNG of the original"/>
                        <Button Command="{Binding ExportDdsCommand}" Margin="4,0,0,0" Content="DDS..." ToolTip="Original DDS and its sidecar, for texconv or Photoshop workflows"/>
                    </UniformGrid>
                    <Button Command="{Binding ExportViewCommand}" Margin="0,8,0,0" Content="Save current view as PNG..."
                            ToolTip="What you see: selected mip, channel and exposure"/>

                    <TextBlock Text="DETAILS" Style="{StaticResource Label}" Margin="0,22,0,6"/>
                    <ItemsControl ItemsSource="{Binding Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource TextFaint}" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Padding="0" MinHeight="0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Dim}" FontSize="11.5" Margin="0,6,0,0" Text="Select a texture to see its details."
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>