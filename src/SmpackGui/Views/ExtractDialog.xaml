<Window x:Class="SmpackGui.Views.ExtractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="Extract">
    <StackPanel Margin="24,22,24,20" Width="520">
        <TextBlock x:Name="Heading" Style="{StaticResource H2}" FontSize="17"/>
        <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource Label}" Margin="0,16,0,4"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="Browse_Click"/>
            <TextBox x:Name="OutDir"/>
        </DockPanel>
        <TextBlock Text="FILTER (Optional)" Style="{StaticResource Label}" Margin="0,14,0,4"/>
        <TextBox x:Name="Filter" Tag="Only entries whose name contains..."/>
        <TextBlock Text="OPTIONS" Style="{StaticResource Label}" Margin="0,16,0,8"/>
        <CheckBox x:Name="NoDds" Content="Skip DDS conversion of WAD textures (chunks only, faster)" Margin="0,0,0,8"/>
        <CheckBox x:Name="Raw" Content="Raw: dump texpack stream blocks without detiling" Margin="0,0,0,8"/>
        <CheckBox x:Name="Blocks" Content="Also split geometry groups into 'blocks\[hash].bin' (for lodpack patches)"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button Content="Extract" IsDefault="True" MinWidth="110" Style="{StaticResource AccentButton}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>