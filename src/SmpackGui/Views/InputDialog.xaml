<Window x:Class="SmpackGui.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="smpack">
    <StackPanel Margin="24,22,24,20" Width="420">
        <TextBlock x:Name="Heading" Style="{StaticResource H2}" FontSize="16"/>
        <TextBlock x:Name="Prompt" Style="{StaticResource Dim}" Margin="0,10,0,8"/>
        <TextBox x:Name="Input"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button Content="OK" IsDefault="True" MinWidth="90" Style="{StaticResource AccentButton}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>