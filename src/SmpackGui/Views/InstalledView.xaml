<UserControl x:Class="SmpackGui.Views.InstalledView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmpackGui.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:InstalledViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,20" MaxWidth="1000" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding RestoreAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" Style="{StaticResource BtnIcon}"/>
                            <TextBlock Text="Restore vanilla game"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Installed changes" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Patch packs" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,4,0,12"
                               Text="Registered in 'exec\boot-options.json'. Texture patches are searched before the game's own packs (first in the list wins). Geometry patches override by block hash."/>
                    <ItemsControl ItemsSource="{Binding Patches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Bg1}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Remove"
                                                Command="{Binding DataContext.RemovePatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" Margin="0,0,12,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}"/>
                                            <TextBlock Foreground="{StaticResource TextFaint}" FontSize="11.5">
                                                <Run Text="{Binding KindLabel, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding Status, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No patch packs registered." Foreground="{StaticResource TextFaint}"
                               Visibility="{Binding Patches.Count, Converter={StaticResource NotNullVis}, ConverterParameter=invert}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Replaced game files" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,4,0,12"
                               Text="Every file smpack overwrote keeps its original next to it as *.smpack-orig. Restoring moves the original back."/>
                    <ItemsControl ItemsSource="{Binding Backups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Bg1}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Restore original"
                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" Foreground="{StaticResource Ember}" Margin="0,0,12,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}"/>
                                            <TextBlock Foreground="{StaticResource TextFaint}" FontSize="11.5">
                                                <Run Text="{Binding Folder, Mode=OneWay}"/><Run Text=", original "/><Run Text="{Binding SizeLabel, Mode=OneWay}"/><Run Text=", backed up "/><Run Text="{Binding Created, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No game files have been replaced." Foreground="{StaticResource TextFaint}"
                               Visibility="{Binding Backups.Count, Converter={StaticResource NotNullVis}, ConverterParameter=invert}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>