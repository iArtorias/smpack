<Window x:Class="SmpackGui.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="smpack">
    <StackPanel Margin="24,22,24,20" MaxWidth="520" MinWidth="360">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="Heading" Style="{StaticResource H2}" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
        </StackPanel>
        <TextBox x:Name="Body" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"
                 Foreground="{StaticResource TextDim}" MaxHeight="360" VerticalScrollBarVisibility="Auto"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelBtn" IsCancel="True" MinWidth="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkBtn" IsDefault="True" MinWidth="90" Style="{StaticResource AccentButton}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>