<UserControl x:Class="SmpackGui.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmpackGui.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ProjectViewModel}">
    <Grid>
        <!-- No project. -->
        <Grid Visibility="{Binding HasProject, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <Border Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Padding="30">
                <StackPanel>
                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="32" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="Your mod" Style="{StaticResource H1}" Margin="0,12,0,0"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,20"
                               Text="A mod project collects your replaced textures, models and sounds. Building it writes patch packs the game loads before its own files and rebuilds the WADs and audio packs you touched. Every original is backed up, so uninstalling is one click."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding NewCommand}" Padding="16,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource BtnIcon}"/>
                                <TextBlock Text="New mod"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenCommand}" Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource BtnIcon}"/>
                                <TextBlock Text="Open..."/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="RECENT" Style="{StaticResource Label}" Margin="0,24,0,6"
                               Visibility="{Binding Recent, Converter={StaticResource NotNullVis}}"/>
                    <ItemsControl ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="8,6"
                                        Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource BtnIcon}"/>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Project. -->
        <Grid Visibility="{Binding HasProject, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <DockPanel Margin="20,18,14,12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Open project folder" Command="{Binding OpenFolderCommand}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Open another project..." Command="{Binding OpenCommand}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New project..." Command="{Binding NewCommand}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close project" Command="{Binding CloseCommand}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Bg1}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding HasTextures, Converter={StaticResource BoolVis}}">
                        <ListBox ItemsSource="{Binding Entries}" Margin="4" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="64" Height="64" CornerRadius="6" Background="{StaticResource Checker}" ClipToBounds="True">
                                            <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,2,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,3,0,0">
                                                <Run Text="{Binding SizeLabel, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding Format, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding Where, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextFaint}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="from"/>
                                                <Run Text="{Binding SourceLabel, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Re-convert from the source image (after you edited it)"
                                                    Command="{Binding DataContext.RefreshSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Open the source image"
                                                    Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Show in Textures"
                                                    Command="{Binding DataContext.ShowEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove from the mod"
                                                    Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{StaticResource BorderStrong}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nothing replaced yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <TextBlock Text="Pick a texture on the Textures page and choose Replace with image, a model on the Models page and choose Replace with edited model, or a sound on the Audio page and choose Replace." Style="{StaticResource Dim}"
                                   TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Models. -->
                    <StackPanel Grid.Row="1" Visibility="{Binding HasModels, Converter={StaticResource BoolVis}}" Margin="0,12,0,0">
                        <TextBlock Text="MODELS" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                        <Border Background="{StaticResource Bg1}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MaxHeight="220">
                            <ListBox ItemsSource="{Binding ModelEntries}" Margin="4" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="6" Background="{StaticResource Bg3}">
                                                <TextBlock Text="&#xE81E;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Where, Mode=OneWay}"/><Run Text=", from "/><Run Text="{Binding SourceLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Copy the source file again (after you edited it)"
                                                        Command="{Binding DataContext.RefreshModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove from the mod"
                                                        Command="{Binding DataContext.RemoveModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>

                    <!-- Sounds. -->
                    <StackPanel Grid.Row="2" Visibility="{Binding HasAudio, Converter={StaticResource BoolVis}}" Margin="0,12,0,0">
                        <TextBlock Text="SOUNDS" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                        <Border Background="{StaticResource Bg1}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MaxHeight="260">
                            <ListBox ItemsSource="{Binding AudioEntries}" Margin="4" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="6" Background="{StaticResource Bg3}">
                                                <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Where, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding SizeLabel, Mode=OneWay}"/><Run Text=", from "/><Run Text="{Binding SourceLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Show on the Audio page"
                                                        Command="{Binding DataContext.ShowAudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove from the mod"
                                                        Command="{Binding DataContext.RemoveAudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- Side panel. -->
            <Border Grid.Column="1" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="MOD" Style="{StaticResource Label}"/>
                        <TextBlock Text="Name" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,4,0,4"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Patch pack name" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,12,0,4"/>
                        <TextBox Text="{Binding PatchName, UpdateSourceTrigger=PropertyChanged, Delay=400}" FontFamily="{StaticResource MonoFont}"
                                 ToolTip="File name of the patch texpack and lodpack in exec\wad\pc_le and their entries in boot-options.json (max 31 characters)"/>
                        <TextBlock Text="{Binding PatchNameError}" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding PatchNameError, Converter={StaticResource NotNullVis}}"/>
                        <TextBlock Text="Author" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,12,0,4"/>
                        <TextBox Text="{Binding Author, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Description" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,12,0,4"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                 VerticalContentAlignment="Top"/>

                        <TextBlock Text="BUILD OPTIONS" Style="{StaticResource Label}" Margin="0,22,0,8"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SyncWadLowMips}" Margin="0,0,0,10"
                                  ToolTip="Each WAD keeps a small 64x64 copy used at a distance. Updating it avoids the old texture popping in far away, at the cost of rebuilding those WADs.">
                            <StackPanel>
                                <TextBlock Text="Update distant (low mip) copies"/>
                                <TextBlock Text="Rewrites the WADs that reference the texture" Foreground="{StaticResource TextFaint}" FontSize="11.5"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Compress}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="LZ4 compress output"/>
                                <TextBlock Text="Like the shipped files. Off builds faster" Foreground="{StaticResource TextFaint}" FontSize="11.5"/>
                            </StackPanel>
                        </CheckBox>

                        <Border Background="{StaticResource Bg2}" CornerRadius="8" Padding="12,10" Margin="0,12,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextFaint}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding InstallStatus}" TextWrapping="Wrap" MaxWidth="280"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource AccentButton}" Command="{Binding BuildInstallCommand}" Padding="14,10" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource BtnIcon}" FontSize="15"/>
                                <StackPanel>
                                    <TextBlock Text="Build and install" FontSize="13.5"/>
                                    <TextBlock Text="Backs up anything it replaces" FontWeight="Normal" FontSize="11" Opacity="0.75"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Command="{Binding BuildCommand}" Margin="0,0,4,0" ToolTip="Build into the project's build folder only">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90F;" Style="{StaticResource BtnIcon}"/>
                                    <TextBlock Text="Build only"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding UninstallCommand}" Margin="4,0,0,0" Style="{StaticResource DangerButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource BtnIcon}"/>
                                    <TextBlock Text="Uninstall"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="SHARE" Style="{StaticResource Label}" Margin="0,22,0,6"/>
                        <Button Command="{Binding PackageCommand}" HorizontalContentAlignment="Left"
                                ToolTip="Zip the built files with an install guide for other players">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" Style="{StaticResource BtnIcon}"/>
                                <TextBlock Text="Save as .zip for sharing..."/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenOutputCommand}" Margin="0,8,0,0" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" Style="{StaticResource BtnIcon}"/>
                                <TextBlock Text="Open build output"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>