<Window x:Class="SmpackGui.Views.ReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="Replace texture">
    <StackPanel Margin="24,22,24,20" Width="640">
        <TextBlock Text="Replace texture" Style="{StaticResource H2}" FontSize="17"/>
        <TextBlock x:Name="TexName" Foreground="{StaticResource TextDim}" Margin="0,4,0,16" TextTrimming="CharacterEllipsis"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ORIGINAL" Style="{StaticResource Label}"/>
                <Border Height="250" CornerRadius="8" Background="{StaticResource Checker}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        ClipToBounds="True">
                    <Image x:Name="OrigImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock x:Name="OrigInfo" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource TextFaint}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2">
                <TextBlock Text="YOUR IMAGE" Style="{StaticResource Label}"/>
                <Border Height="250" CornerRadius="8" Background="{StaticResource Checker}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                        ClipToBounds="True">
                    <Image x:Name="NewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock x:Name="NewInfo" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="OUTPUT SIZE" Style="{StaticResource Label}"/>
                <StackPanel x:Name="SizeOptions"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="COMPRESSION QUALITY" Style="{StaticResource Label}"/>
                <ComboBox x:Name="QualityBox" SelectedIndex="1">
                    <ComboBoxItem Content="Fast"/>
                    <ComboBoxItem Content="Balanced"/>
                    <ComboBoxItem Content="Best (slow)"/>
                </ComboBox>
                <TextBlock x:Name="FormatInfo" Foreground="{StaticResource TextFaint}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="AllWads" Margin="0,14,0,0" IsChecked="True" Visibility="Collapsed"/>

        <Border x:Name="MsgBox" CornerRadius="8" Padding="12,10" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock x:Name="MsgText" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button x:Name="OkBtn" IsDefault="True" MinWidth="130" Style="{StaticResource AccentButton}" Click="Ok_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8AB;" Style="{StaticResource BtnIcon}"/>
                    <TextBlock Text="Add to my mod"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>