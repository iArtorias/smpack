<Application x:Class="SmpackGui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:SmpackGui.Services"
             xmlns:vm="clr-namespace:SmpackGui.ViewModels"
             xmlns:v="clr-namespace:SmpackGui.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <s:BoolToVisibility x:Key="BoolVis"/>
            <s:NotNullToVisibility x:Key="NotNullVis"/>
            <s:InverseBool x:Key="Not"/>
            <s:EnumEquals x:Key="EnumEq"/>
            <s:BytesToText x:Key="Bytes"/>
            <s:LogKindToBrush x:Key="LogBrush"/>

            <DataTemplate DataType="{x:Type vm:TexturesViewModel}">
                <v:TexturesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProjectViewModel}">
                <v:ProjectView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ArchivesViewModel}">
                <v:ArchivesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstalledViewModel}">
                <v:InstalledView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <v:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModelsViewModel}">
                <v:ModelsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AudioViewModel}">
                <v:AudioView/>
            </DataTemplate>

            <!-- Shared look for dialog windows. -->
            <Style x:Key="DialogWindow" TargetType="Window">
                <Setter Property="Background" Value="{StaticResource Bg1}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="ResizeMode" Value="NoResize"/>
                <Setter Property="SizeToContent" Value="WidthAndHeight"/>
                <Setter Property="ShowInTaskbar" Value="False"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>