<Window x:Class="SmpackGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmpackGui.ViewModels"
        Title="smpack - God of War Ragnarök AIO modding tool" Icon="Assets/app.ico"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" MinWidth="1060" MinHeight="640"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="textures"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="models"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="audio"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="project"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="archives"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="installed"/>
        <KeyBinding Key="OemTilde" Modifiers="Control" Command="{Binding ToggleLogCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Navigation rail. -->
        <Border Grid.RowSpan="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,14,10,10">
                <Image DockPanel.Dock="Top" Source="Assets/logo.png" Width="40" Height="40" Margin="0,0,0,18" RenderOptions.BitmapScalingMode="HighQuality"
                       ToolTip="smpack GUI"/>
                <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                             IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=settings, Mode=OneWay}"
                             Command="{Binding NavigateCommand}" CommandParameter="settings" GroupName="nav"/>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xEB9F;" Content="Textures" GroupName="nav" ToolTip="Browse and replace textures (Ctrl+1)"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=textures, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="textures"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE81E;" Content="Models" GroupName="nav" ToolTip="Preview models in 3D and export to glTF or FBX (Ctrl+2)"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=models, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="models"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8D6;" Content="Audio" GroupName="nav" ToolTip="Listen to, export and replace game sounds (Ctrl+3)"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=audio, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="audio"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7B8;" Content="My mod" GroupName="nav" ToolTip="Your mod project: build and install (Ctrl+4)"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=project, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="project"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8B7;" Content="Archives" GroupName="nav" ToolTip="Every game archive: inspect, extract and rebuild (Ctrl+5)"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=archives, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="archives"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE777;" Content="Installed" GroupName="nav" ToolTip="What is changed in the game, and restore (Ctrl+6)"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumEq}, ConverterParameter=installed, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="installed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page. -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>

        <!-- Log console. -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Height="190" Visibility="{Binding LogExpanded, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,6,8,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy log" Command="{Binding CopyLogCommand}" Width="28" Height="26"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Clear" Command="{Binding ClearLogCommand}" Width="28" Height="26"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Hide (Ctrl+`)" Command="{Binding ToggleLogCommand}" Width="28" Height="26"/>
                    </StackPanel>
                    <TextBlock Text="ACTIVITY" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/>
                </DockPanel>
                <ListBox x:Name="LogList" ItemsSource="{Binding Log.Entries}" Margin="6,2,6,6" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="3">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource TextFaint}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Prefix}" Foreground="{Binding Kind, Converter={StaticResource LogBrush}}" Width="14"/>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Kind, Converter={StaticResource LogBrush}}" TextTrimming="None"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Status bar. -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Project.Title}" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,18,0"/>
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Danger}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SmpackOk}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding SmpackStatus}" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,14,0"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleLogCommand}" MinHeight="24" Padding="8,2" FontSize="12"
                            ToolTip="Show or hide the activity log (Ctrl+`)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;" Style="{StaticResource BtnIcon}" FontSize="12"/>
                            <TextBlock Text="Log"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                    <Path Style="{StaticResource Spinner}" Width="14" Height="14" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" MaxWidth="520"
                               TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Width="160" Margin="14,0,0,0" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelCommand}" MinHeight="24" Padding="8,2" FontSize="12"
                            Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding GameLabel}" Foreground="{StaticResource TextFaint}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
            </DockPanel>
        </Border>

        <!-- Toast. -->
        <Border Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" MaxWidth="520"
                CornerRadius="10" Padding="14,10" BorderThickness="1"
                Visibility="{Binding ToastText, Converter={StaticResource NotNullVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Bg3}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastKind}" Value="Success">
                            <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="Warning">
                            <Setter Property="Background" Value="{StaticResource WarningSoft}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Warning}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="Error">
                            <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24"
                        Command="{Binding DismissToastCommand}" Margin="10,0,-4,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>